<Window x:Class="MinecraftSessionTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Minecraft Account Manager" Width="1160" Height="780" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#FAF8FC" Foreground="#332A42" FontFamily="Segoe UI" FontSize="13" Icon="Assets/app.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing" AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#332A42" />
    <SolidColorBrush x:Key="Muted" Color="#8C7D9E" />
    <SolidColorBrush x:Key="Accent" Color="#7C5CB7" />
    <SolidColorBrush x:Key="AccentBg" Color="#F0E8F8" />
    <SolidColorBrush x:Key="BorderColor" Color="#EAE0F2" />
    <Style TargetType="CheckBox">
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Foreground" Value="#6F4FA6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="HitArea" Background="Transparent" CornerRadius="7" Padding="7" BorderThickness="1" BorderBrush="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CheckSurface" Width="22" Height="22" CornerRadius="6" Background="White" BorderBrush="#B9A5CF" BorderThickness="1.5" VerticalAlignment="Center">
                  <Grid>
                    <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Border x:Name="MixedMark" Height="3" Width="10" CornerRadius="1.5" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                  </Grid>
                </Border>
                <ContentPresenter x:Name="CheckContent" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="HasContent" Value="False">
                <Setter TargetName="CheckContent" Property="Margin" Value="0" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#7C5CB7" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#7C5CB7" />
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#7C5CB7" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="CheckSurface" Property="Background" Value="#7C5CB7" />
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#7C5CB7" />
                <Setter TargetName="MixedMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HitArea" Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#49306F" />
                <Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#9584A8" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F1EBF8" />
      <Setter Property="Foreground" Value="#6F4FA6" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#59416F" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.38" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#7C5CB7" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FDF0F0" />
      <Setter Property="Foreground" Value="#C0392B" />
    </Style>
    <!-- Modern Card -->
    <Style x:Key="ModernCard" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#EAE0F2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <!-- Editable input field -->
    <Style x:Key="InputField" TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#3F3452" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#E2D6F0" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#B697D6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Readonly TextBox -->
    <Style x:Key="ReadOnlyField" TargetType="TextBox">
      <Setter Property="Background" Value="#F9F7FC" />
      <Setter Property="Foreground" Value="#3F3452" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="Segoe UI, Consolas" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#EAE2F2" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="#FFFCFF" />
      <Setter Property="Foreground" Value="#59416F" />
      <Setter Property="BorderBrush" Value="#E2D6F0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountMenuItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#59416F" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#EDE2F6" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#FFFCFF" />
      <Setter Property="Foreground" Value="#59416F" />
      <Setter Property="BorderBrush" Value="#E2D6F0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
  </Window.Resources>
  <Grid Background="#FAF8FC" x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Window Title Bar -->
    <Border Background="#F4EEF9" BorderBrush="#EAE0F2" BorderThickness="0,0,0,1">
      <Grid Margin="16,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Brand Name in Titlebar -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/cookie.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <TextBlock Text="Minecraft Account Manager" FontSize="12" FontWeight="SemiBold" Foreground="#5E4B7A" VerticalAlignment="Center" />
          <Border Background="#E6DBF2" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" x:Name="VersionEggTarget" MouseLeftButtonDown="VersionEgg_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="v1.0.2" FontSize="9" FontWeight="Bold" Foreground="#7756A8" x:Name="TitleVersionText" />
          </Border>
          <!-- Update Badge -->
        </StackPanel>
        <!-- Window Control Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="36" Height="28" Background="Transparent" Padding="0" Click="Minimize_Click" ToolTip="Thu nhỏ" />
          <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="36" Height="28" Background="Transparent" Padding="0" Click="Maximize_Click" ToolTip="Phóng to / Khôi phục" />
          <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="36" Height="28" Background="Transparent" Padding="0" Click="Close_Click" ToolTip="Đóng" />
        </StackPanel>
        <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Name="UpdateBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,12,0" Padding="12,6" Background="#FFF0DA" Foreground="#B66D25" BorderBrush="#EAC18E" BorderThickness="1" Visibility="Collapsed" Click="UpdateBadge_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Xem và cài đặt phiên bản mới">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↑" FontSize="15" FontWeight="Bold" Margin="0,0,7,0" />
            <TextBlock x:Name="UpdateBadgeText" Text="Có bản mới" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <!-- Main Workspace (Category Sidebar + Active Category Content) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" x:Name="SidebarColumn" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- CỘT DANH MỤC (CATEGORY SIDEBAR) -->
      <Border Background="#F4EEF8" BorderBrush="#EAE0F2" BorderThickness="0,0,1,0">
        <Grid Margin="12,14,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- Danh Mục Section -->
          <StackPanel Grid.Row="0">
            <TextBlock Text="DANH MỤC" FontSize="10" FontWeight="Bold" Foreground="#9C8BAC" Margin="6,0,0,10" />
            <!-- Category Item 1: Cookie -->
            <Border x:Name="NavCookieBtn" Background="#EDE2F6" BorderBrush="#C9B3E4" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="NavCookie_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🍪" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Account" FontSize="13" FontWeight="Bold" Foreground="#5E3D8E" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#DFCEF2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock x:Name="CategoryCookieCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#6C4CA7" />
                </Border>
              </Grid>
            </Border>
            <!-- Category Item 2: Proxy -->
            <Border x:Name="NavProxyBtn" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="NavProxy_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🌐" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Proxy" FontSize="13" FontWeight="SemiBold" Foreground="#7D6B92" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#EBE2F2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock x:Name="CategoryProxyCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#85719B" />
                </Border>
              </Grid>
            </Border>
            <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="NavLogsBtn" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="NavLogs_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#8D76A5" />
                <TextBlock Grid.Column="1" Text="Nhật ký" FontSize="13" FontWeight="SemiBold" Foreground="#7D6B92" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#EBE2F2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock x:Name="CategoryLogCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#85719B" />
                </Border>
              </Grid>
            </Border>
          </StackPanel>
          <!-- Bottom of Category Sidebar -->
          <StackPanel Grid.Row="2">
            <!-- Open Storage Folder Button -->
            <Button Click="OpenFolder_Click" Background="#EBE0F4" Foreground="#6B4CA4" Padding="10,8" Margin="0,0,0,10" ToolTip="Mở thư mục lưu trữ ~/minecraft_cookie_manager">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="📁" FontSize="12" Margin="0,0,7,0" />
                <TextBlock Text="Thư mục lưu trữ" FontSize="11" />
              </StackPanel>
            </Button>
            <!-- Author, Version & GitHub Star Card -->
            <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="AuthorButton" Click="OpenAuthor_Click" Background="#FFFFFF" BorderBrush="#E4D7EF" Padding="10,12" HorizontalContentAlignment="Stretch" ToolTip="Một chút về GauCandy ♡">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="34" Height="34" Margin="0,0,9,0">
                  <Ellipse.Fill>
                    <ImageBrush ImageSource="Assets/github-avatar.png" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="GauCandy" FontSize="12" FontWeight="SemiBold" Foreground="#59416F" />
                  <TextBlock Text="made with a little ♡" FontSize="9" Foreground="#A18BB1" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="✧" FontSize="18" Foreground="#BEA0D2" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- RIGHT CONTENT: DYNAMIC VIEW (COOKIE OR PROXY) -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- VIEW 1: ACCOUNTS -->
        <Grid x:Name="CookieView" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Header bar: title, search, proxy status, add -->
          <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAE0F2" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="TÀI KHOẢN" FontSize="15" FontWeight="Bold" Foreground="#3E2E55" VerticalAlignment="Center" />
                  <Border Background="#E6DAF2" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountsCountText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#7756A8" />
                  </Border>
                </StackPanel>
                <Grid Grid.Column="2" Width="210" Margin="12,0,8,0" VerticalAlignment="Center">
                  <TextBox x:Name="SearchBox" Style="{StaticResource InputField}" Padding="11,6" TextChanged="Search_TextChanged" ToolTip="Tìm theo tên người chơi hoặc tag" />
                  <TextBlock x:Name="SearchPlaceholder" Text="Tìm tên hoặc tag…" FontSize="11.5" Foreground="#B0A2C0" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" />
                </Grid>
                <Border x:Name="ProxyPoolBadge" Grid.Column="3" Background="#F1EAF7" CornerRadius="8" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ProxyBadge_Click" ToolTip="Trạng thái proxy khi lấy / làm mới token">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProxyPoolIcon" Text="🌐" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProxyPoolText" Text="IP máy" FontSize="11" FontWeight="SemiBold" Foreground="#85719B" VerticalAlignment="Center" TextWrapping="NoWrap" />
                  </StackPanel>
                </Border>
                <Button x:Name="AddAccountButton" Grid.Column="4" Click="AddAccount_Click" Style="{StaticResource PrimaryButton}" Padding="13,7" VerticalAlignment="Center" ToolTip="Thêm tài khoản bằng đăng nhập Microsoft hoặc cookie">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+  Thêm tài khoản" TextWrapping="NoWrap" />
                    <TextBlock Text="⌄" Margin="7,-3,0,0" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource AccountMenu}">
                      <MenuItem Style="{StaticResource AccountMenuItem}" Header="🔑   Đăng nhập Microsoft" Click="MicrosoftLogin_Click" ToolTip="Nhập mã trên trang Microsoft — không cần cookie" />
                      <Separator />
                      <MenuItem Style="{StaticResource AccountMenuItem}" Header="🍪   Nhập cookie…" Click="OpenCookieImport_Click" ToolTip="Dán cookie hoặc chọn file (.txt / .json / .cookies)" />
                      <MenuItem Style="{StaticResource AccountMenuItem}" Header="🔁   Nhập refresh token…" Click="OpenRefreshImport_Click" ToolTip="Dán refresh token Microsoft (mỗi dòng một token)" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </Grid>
              <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ToolTip="Cuộn để xem thêm tag"><WrapPanel x:Name="TagFilterPanel" Margin="0,8,0,0" Visibility="Collapsed" /></ScrollViewer>
            </StackPanel>
          </Border>
          <!-- Body: list | detail -->
          <Grid Grid.Row="1" x:Name="AccountWorkspace">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" MinWidth="0" MaxWidth="440" x:Name="AccountsColumn" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Left: account list -->
            <Border Background="#F9F6FC" BorderBrush="#EAE0F2" BorderThickness="0,0,1,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Select-all bar -->
                <Border x:Name="AccountsToolbar" Padding="16,9" BorderBrush="#EFE7F6" BorderThickness="0,0,0,1" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllCheck" Content="Chọn tất cả" IsThreeState="True" Click="SelectAll_Click" FontSize="11.5" Foreground="#7D6B91" VerticalAlignment="Center" />
                    <TextBlock x:Name="ListCountText" Grid.Column="1" FontSize="11" Foreground="#A495B5" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <!-- List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,4">
                  <StackPanel>
                    <StackPanel x:Name="AccountsListContainer" />
                    <Border x:Name="EmptyAccountsPlaceholder" Background="#FFFFFF" BorderBrush="#EFE7F6" BorderThickness="1" CornerRadius="12" Padding="16,26" Margin="0,4,0,0">
                      <StackPanel HorizontalAlignment="Center">
                        <Image Source="Assets/cookie.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock x:Name="EmptyListTitle" Text="Chưa có tài khoản nào" FontWeight="SemiBold" Foreground="#6E5B85" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5" />
                        <TextBlock x:Name="EmptyListHint" Text="Bấm '+ Thêm tài khoản' ở góc trên, hoặc thả file cookie vào cửa sổ." Foreground="#A393B4" FontSize="11" TextAlignment="Center" Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                <!-- Bulk action bar (pinned bottom) -->
                <Border x:Name="BulkActionsPanel" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4D7EF" BorderThickness="0,1,0,0" Padding="12,10,12,12" Visibility="Collapsed">
                  <StackPanel>
                    <Grid Margin="2,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="BulkSelectedText" Text="Đã chọn 0 tài khoản" FontSize="12" FontWeight="SemiBold" Foreground="#5E3D8E" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Bỏ chọn" Click="ClearSelection_Click" Background="Transparent" Foreground="#9C85AE" Padding="6,2" FontSize="11" />
                    </Grid>
                    <UniformGrid Columns="3">
                      <Button x:Name="BulkRefreshButton" Content="⚡ Làm mới" Click="BulkRefresh_Click" Style="{StaticResource PrimaryButton}" Padding="6,7" FontSize="11" Margin="0,0,4,0" ToolTip="Làm mới token các tài khoản đã chọn — chạy song song theo số proxy" />
                      <Button x:Name="BulkCopyButton" Content="📋 Sao chép" Click="BulkCopy_Click" Padding="6,7" FontSize="11" Margin="2,0,2,0" ToolTip="Sao chép mã NFA của các tài khoản đã chọn, mỗi dòng một mã" />
                      <Button x:Name="BulkTagButton" Content="🏷 Tag" Click="BulkTag_Click" Padding="6,7" FontSize="11" Margin="4,0,0,0" ToolTip="Gắn hoặc gỡ tag cho các tài khoản đã chọn" />
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <!-- Right: detail -->
            <ScrollViewer x:Name="AccountDetailPane" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="20,16,20,16">
                <ProgressBar x:Name="WorkProgress" Height="3" Margin="0,0,0,10" Foreground="#8864BD" Background="#EFE7F6" BorderThickness="0" Visibility="Collapsed" />
                <!-- Empty state -->
                <Border x:Name="DetailEmptyState" Style="{StaticResource ModernCard}" Padding="28,40">
                  <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                    <Image Source="Assets/cookie.png" Width="46" Height="46" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock Text="Cho mượn tài khoản, không cần đưa mật khẩu" FontSize="17" FontWeight="Bold" Foreground="#3E2E55" TextAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Thêm tài khoản Minecraft vào app, rồi chỉ gửi mã NFA cho người mượn. Mã tự hết hạn và không đổi được mật khẩu Microsoft." FontSize="12" Foreground="#8C7D9E" TextAlignment="Center" LineHeight="19" Margin="0,8,0,22" />
                    <Button Content="🔑   Đăng nhập Microsoft" Click="MicrosoftLogin_Click" Style="{StaticResource PrimaryButton}" Padding="16,10" Margin="0,0,0,8" />
                    <Button Content="🍪   Nhập cookie" Click="OpenCookieImport_Click" Padding="16,10" Margin="0,0,0,8" />
                    <Button Content="🔁   Nhập refresh token" Click="OpenRefreshImport_Click" Padding="16,10" />
                  </StackPanel>
                </Border>
                <!-- Detail content -->
                <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                  <Border Style="{StaticResource ModernCard}" Margin="0,0,0,12">
                    <StackPanel>
                      <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" Background="#EDE2F7" CornerRadius="12" Margin="0,0,13,0" ClipToBounds="True">
                          <Grid>
                            <TextBlock x:Name="ActiveInitialText" Text="✿" Foreground="#7A56A8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ActiveAvatarImage" Width="52" Height="52" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill" Visibility="Collapsed" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <WrapPanel>
                            <TextBlock x:Name="ActiveAccountTitle" Text="Chưa chọn tài khoản" FontSize="17" FontWeight="Bold" Foreground="#332845" Margin="0,0,8,4" />
                            <Border x:Name="ActiveStatusBadge" Background="#EDF7EE" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                              <TextBlock x:Name="ActiveStatusText" Text="Sẵn sàng" FontSize="10" FontWeight="Bold" Foreground="#4E8C5C" />
                            </Border>
                            <Button Content="Sao chép tên" Click="CopyUsername_Click" Padding="7,3" FontSize="10" Margin="6,0,0,4" />
                          </WrapPanel>
                          <TextBlock x:Name="ActiveAccountSubtitle" Text="" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                      <!-- Primary action: copy NFA -->
                      <Button x:Name="CopyTokenButton" Click="CopyToken_Click" IsEnabled="False" HorizontalContentAlignment="Stretch" Style="{StaticResource PrimaryButton}" Padding="14,11" ToolTip="Sao chép mã NFA (Minecraft Access Token) để gửi cho người mượn">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="📋  Sao chép mã NFA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="Ctrl+V để dán" FontSize="10" Opacity="0.8" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="RefreshButton" Content="⚡ Làm mới" Click="RefreshCurrent_Click" Background="#EDE4F7" Foreground="#6F4FA6" Padding="11,7" FontSize="11" IsEnabled="False" Margin="0,0,6,6" ToolTip="Lấy mã NFA mới cho tài khoản này" />
                        <Button x:Name="ExportCookieButton" Content="📤 Xuất cookie" Click="ExportCookie_Click" Padding="11,7" FontSize="11" IsEnabled="False" Margin="0,0,6,6" />
                        <Button x:Name="DeleteButton" Content="🗑 Xóa" Click="DeleteCurrent_Click" Style="{StaticResource DangerButton}" Padding="11,7" FontSize="11" IsEnabled="False" Margin="0,0,0,6" />
                      </WrapPanel>
                      <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,0,0,12" x:Name="IdentityFields">
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="UUID NGƯỜI CHƠI" Style="{StaticResource SectionHeader}" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBox x:Name="UuidField" Text="Sẽ hiển thị khi chọn tài khoản" Style="{StaticResource ReadOnlyField}" />
                              <Button Content="Sao chép" Click="CopyUuid_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" Background="#EAE0F2" Foreground="#6C4EA3" Padding="7,3" FontSize="10" Grid.Column="1" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="MÃ NFA (MINECRAFT ACCESS TOKEN)" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                          <CheckBox x:Name="RevealToken" Grid.Column="1" Content="Hiện mã" HorizontalAlignment="Right" FontSize="11" Foreground="#88739E" IsEnabled="False" Checked="RevealToken_Changed" Unchecked="RevealToken_Changed" />
                        </Grid>
                        <Grid MinHeight="44">
                          <Border Background="#F9F7FC" CornerRadius="8" BorderBrush="#EAE2F2" BorderThickness="1" />
                          <TextBlock x:Name="TokenPlaceholder" Text="Chưa có mã (chọn hoặc làm mới tài khoản)" Foreground="#A595B5" FontSize="11" VerticalAlignment="Center" Margin="11,0" />
                          <PasswordBox x:Name="TokenPassword" Background="Transparent" BorderThickness="0" Padding="11,8" Foreground="#584275" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />
                          <TextBox x:Name="TokenField" Style="{StaticResource ReadOnlyField}" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" MinHeight="44" TextWrapping="Wrap" MaxHeight="110" ToolTip="Mã dài tự xuống dòng. Cuộn trong ô để xem thêm; Ctrl+A để chọn toàn bộ." />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <!-- Identity + token -->
                  <!-- Tags + cookie info -->
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="14">
                      <StackPanel>
                        <TextBlock Text="TAG PHÂN LOẠI" Style="{StaticResource SectionHeader}" />
                        <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ToolTip="Cuộn để xem thêm tag"><WrapPanel x:Name="TagChipsPanel" Margin="0,2,0,0" /></ScrollViewer>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox x:Name="TagInputBox" Style="{StaticResource InputField}" Padding="9,6" FontSize="11" MaxLength="24" ToolTip="Nhập tên tag rồi nhấn Enter" KeyDown="TagInput_KeyDown" />
                          <Button x:Name="AddTagButton" Grid.Column="1" Content="+ Tag" Click="AddTag_Click" Background="#EAE0F2" Foreground="#6C4EA3" Padding="10,6" FontSize="11" Margin="6,0,0,0" IsEnabled="False" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="14" ToolTip="Thống kê cookie đăng nhập Microsoft/Xbox/Minecraft. Mốc gần nhất không phải hạn chung của tài khoản; cookie có thể bị thu hồi trước hạn. Hạn token Minecraft được tính riêng.">
                      <StackPanel>
                        <TextBlock Text="COOKIE ĐĂNG NHẬP" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="CookieSummaryText" Text="Chưa có thông tin cookie" FontSize="12" Foreground="#806691" Margin="0,2,0,0" />
                        <TextBlock x:Name="CookieExpiryText" Text="Chọn tài khoản để xem hạn cookie." FontSize="11" Foreground="#AA93B7" Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
        <!-- VIEW 2: PROXY MANAGER -->
        <Grid x:Name="ProxyView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- Proxy Top Toolbar -->
          <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAE0F2" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="PROXY · LÀM MỚI ĐA LUỒNG" FontSize="15" FontWeight="Bold" Foreground="#3E2E55" Margin="0,0,8,0" />
                  <Border Background="#E6DAF2" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProxyTotalCountText" Text="0 proxy" FontSize="10" FontWeight="Bold" Foreground="#7756A8" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Proxy giúp làm mới mã NFA của nhiều tài khoản nhanh hơn: mỗi proxy chạy một luồng riêng, nên app làm mới đa luồng thay vì lần lượt từng tài khoản." FontSize="11" Foreground="#7D6B91" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ProxyBenefitText" Text="Chưa có proxy: app dùng IP máy, làm mới từng tài khoản một." FontSize="11" FontWeight="SemiBold" Foreground="#6C4CA7" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="Định dạng: host:port:user:pass (mặc định SOCKS5). Proxy HTTP thêm tiền tố http://." FontSize="10.5" Foreground="#9281A4" Margin="0,3,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Button x:Name="OpenProxyAddButton" Content="+ Thêm proxy" Click="OpenProxyAdd_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
                <Button x:Name="TestAllProxiesBtn" Content="⚡ Kiểm tra tất cả" Click="TestAllProxies_Click" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,8,6" />
                <Button Content="🗑 Xóa tất cả" Click="ClearAllProxies_Click" Style="{StaticResource DangerButton}" Padding="10,7" Margin="0,0,8,6" />
              </WrapPanel>
            </Grid>
          </Border>
          <!-- Proxy Workspace (Input + List) -->
          <Grid Grid.Row="1" Margin="18,14,18,12" x:Name="ProxyWorkspace">
            <!-- Left: Add Proxies Box -->
            <!-- Right: Proxy List Cards -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="14" x:Name="ProxyListCard">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="DANH SÁCH PROXY ĐÃ LƯU" Style="{StaticResource SectionHeader}" Margin="0" />
                  <TextBlock x:Name="ProxyLiveSummaryText" Grid.Column="1" Text="0 hoạt động" FontSize="11" Foreground="#4E8C5C" FontWeight="SemiBold" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <StackPanel x:Name="ProxyListContainer" />
                    <!-- Empty Placeholder -->
                    <Border x:Name="EmptyProxyPlaceholder" Background="#FAF8FD" BorderBrush="#EFE7F6" BorderThickness="1" CornerRadius="12" Padding="14,32" Margin="0,10,0,0">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Chưa có proxy — thêm để lấy token nhanh hơn" FontWeight="SemiBold" Foreground="#7D6B91" HorizontalAlignment="Center" FontSize="12" />
                        <TextBlock Text="Bấm “Thêm proxy” để nhập thủ công hoặc dán nhanh danh sách proxy." Foreground="#A393B4" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
          <!-- Proxy Bottom Notice -->
        </Grid>
        <Border x:Name="NoticeBorder" Grid.Row="1" Background="#F1EAF7" BorderBrush="#E7DDF0" BorderThickness="0,1,0,0" Padding="14,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeIcon" Text="♡" FontSize="13" Foreground="#8565AD" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="NoticeText" Grid.Column="1" Text="Chọn file cookie để bắt đầu. Bạn có thể xem quá trình xử lý trong mục Nhật ký." Foreground="#75618F" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="Kéo thả file vào bất kỳ đâu trên cửa sổ để lưu" FontSize="10" Foreground="#A495B5" VerticalAlignment="Center" Visibility="Collapsed" />
          </Grid>
        </Border>
        <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogsView" Visibility="Collapsed" Margin="20,18,20,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Nhật ký hoạt động" FontSize="23" FontWeight="SemiBold" Foreground="#59416F" />
            <TextBlock x:Name="LogSessionText" FontSize="11" Foreground="#A08AAF" Margin="0,6,0,13" />
            <WrapPanel>
              <Button Content="↓  Xuất log báo lỗi" Click="ExportLog_Click" Background="#8664B1" Foreground="White" Padding="14,9" FontSize="12" Margin="0,0,8,8" x:Name="ExportLogButton" />
              <Button Content="Thư mục log" Click="OpenLogsFolder_Click" Padding="12,9" FontSize="12" Margin="0,0,8,8" />
              <Button Content="Xóa phiên này" Click="ClearLog_Click" Padding="12,9" FontSize="12" Background="#FAEFF4" Foreground="#B47A91" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
          <Border Grid.Row="2" Background="White" BorderBrush="#EAE0F2" BorderThickness="1" CornerRadius="14" Padding="6">
            <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Expander x:Name="ImportResultsPanel" Header="Kết quả nhập file" IsExpanded="True" Visibility="Collapsed" Margin="10,8,10,10" Foreground="#846497" FontSize="12">
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="ImportResultsList" Margin="0,8,0,0" />
                </ScrollViewer>
              </Expander>
              <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                <StackPanel x:Name="LogEntries" />
              </ScrollViewer>
            </Grid>
          </Border>
          <TextBlock x:Name="LogStatusText" Grid.Row="3" Foreground="#A38EB3" FontSize="10" Margin="3,12,3,0" Text="Lưu tối đa 10 phiên gần nhất trên máy. Bạn có thể xuất tệp để đính kèm khi báo lỗi." />
        </Grid>
      </Grid>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="AuthorOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#66352B43" Visibility="Collapsed" MouseDown="AuthorBackdrop_MouseDown" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="360" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="24" BorderBrush="#E9DDF2" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#362241" BlurRadius="32" ShadowDepth="8" Opacity="0.22" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid Height="116">
              <Border Background="#F1E6F9" CornerRadius="24,24,0,0" />
              <TextBlock Text="✧" FontSize="34" Foreground="#C6A6DA" Margin="40,22,0,0" />
              <TextBlock Text="♡" FontSize="28" Foreground="#D7A1BC" HorizontalAlignment="Right" Margin="0,45,43,0" />
              <Ellipse Width="76" Height="76" Stroke="#FFFCFF" StrokeThickness="5" VerticalAlignment="Bottom" Margin="0,0,0,-22">
                <Ellipse.Fill>
                  <ImageBrush ImageSource="Assets/github-avatar.png" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
              <Button x:Name="AuthorCloseButton" Content="×" Click="CloseAuthor_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Padding="0" Width="28" Height="28" Background="#FAF5FD" Foreground="#9579AA" FontSize="19" AutomationProperties.Name="Đóng giới thiệu tác giả" />
            </Grid>
            <StackPanel Margin="27,34,27,24">
              <TextBlock Text="Hi, tớ là GauCandy ✨" FontSize="21" FontWeight="SemiBold" Foreground="#59416F" TextAlignment="Center" />
              <TextBlock Text="Một chiếc app nhỏ, được làm bằng chút tò mò và thật nhiều yêu thương." FontSize="12" Foreground="#9A85AA" TextAlignment="Center" Margin="0,10,0,14" LineHeight="20" />
              <!-- Special Thanks to JerTran -->
              <Border Background="#F6EEFB" CornerRadius="12" Padding="14,10" Margin="0,0,0,16" BorderBrush="#E5D3F2" BorderThickness="1">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                    <TextBlock Text="👑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Special thanks to JerTran (Discord)" FontSize="12" FontWeight="Bold" Foreground="#6C4CA7" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Người tiên phong tài trợ đặt nền móng cho dự án" FontSize="11" Foreground="#8A73A0" TextAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Background="#FFF4E5" CornerRadius="14" Padding="18,15" BorderBrush="#F5DEC0" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="Nếu thấy app thật tuyệt vời thì tặng tớ 1 star nhó ♡" FontSize="14" FontWeight="SemiBold" Foreground="#AE753B" TextAlignment="Center" LineHeight="22" />
                  <Button Content="✦   Tặng tớ 1 star" Click="StarRepo_Click" Background="#E7B477" Foreground="#FFFFFF" Margin="0,13,0,0" Padding="14,10" FontSize="13" />
                </StackPanel>
              </Border>
              <Button Content="Ghé GitHub của tớ ↗" Click="GitHubCredit_Click" Background="Transparent" Foreground="#9A7CAE" FontSize="11" Margin="0,12,0,0" Padding="8,6" />
              <TextBlock Text="v1.0.1  ·  AGPL-3.0" FontSize="9" Foreground="#BEACC9" TextAlignment="Center" Margin="0,10,0,0" x:Name="AuthorVersionText" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DropOverlay" Grid.RowSpan="2" Panel.ZIndex="90" Background="#E6F0E8F8" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Width="420" Height="200" CornerRadius="20" Background="#FBF8FE" BorderBrush="#B697D6" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="🍪" FontSize="46" HorizontalAlignment="Center" />
          <TextBlock Text="Thả file cookie vào đây" FontSize="17" FontWeight="Bold" Foreground="#5E3D8E" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <TextBlock Text="Hỗ trợ .txt, .json, .cookies" FontSize="12" Foreground="#9281A4" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Border>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ImportOverlay" Grid.RowSpan="2" Panel.ZIndex="176" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="470" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="22" BorderBrush="#E8DCEF" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#34233E" BlurRadius="30" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <StackPanel Margin="26,22,26,24">
          <TextBlock x:Name="ImportTitle" Text="Nhập cookie" FontSize="22" FontWeight="SemiBold" Foreground="#59416F" />
          <TextBlock x:Name="ImportDescription" Text="" FontSize="12" Foreground="#95819F" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,12" />
          <TextBox x:Name="ImportInput" Style="{StaticResource InputField}" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="130" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="11" Padding="9,8" />
          <TextBlock x:Name="ImportWarning" Text="" FontSize="10.5" Foreground="#B47A91" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Hủy" Click="ImportCancel_Click" Background="#F0E8F7" Foreground="#85639F" Padding="8,10" />
            <Button x:Name="ImportFileButton" Grid.Column="2" Content="📄 File…" Click="ImportChooseFile_Click" Background="#EAE0F2" Foreground="#6C4EA3" Padding="8,10" ToolTip="Chọn file cookie (.txt / .json / .cookies)" />
            <Button Grid.Column="4" Content="📋 Dán" Click="ImportPaste_Click" Background="#EAE0F2" Foreground="#6C4EA3" Padding="8,10" />
            <Button Grid.Column="6" Content="Nhập" Click="ImportApply_Click" Style="{StaticResource PrimaryButton}" Padding="8,10" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="TagOverlay" Grid.RowSpan="2" Panel.ZIndex="175" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="410" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="22" BorderBrush="#E8DCEF" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#34233E" BlurRadius="30" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="26,22,26,24">
            <TextBlock x:Name="TagOverlayTitle" Text="Gắn tag" FontSize="22" FontWeight="SemiBold" Foreground="#59416F" />
            <TextBlock Text="Nhập tên tag (nhiều tag cách nhau bằng dấu phẩy). Tag có sẵn bấm để chọn nhanh." FontSize="12" Foreground="#95819F" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,12" />
            <TextBox x:Name="TagOverlayInput" Style="{StaticResource InputField}" Padding="9,8" FontSize="12" KeyDown="TagOverlayInput_KeyDown" />
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ToolTip="Cuộn để xem thêm tag"><WrapPanel x:Name="TagOverlaySuggestions" Margin="0,10,0,0" /></ScrollViewer>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="Hủy" Click="TagOverlayCancel_Click" Background="#F0E8F7" Foreground="#85639F" Padding="10,10" />
              <Button Grid.Column="2" Content="Gỡ tag" Click="TagOverlayRemove_Click" Background="#FAEFF4" Foreground="#B47A91" Padding="10,10" />
              <Button Grid.Column="4" Content="Gắn tag" Click="TagOverlayApply_Click" Style="{StaticResource PrimaryButton}" Padding="10,10" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LoginOverlay" Grid.RowSpan="2" Panel.ZIndex="180" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="410" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="22" BorderBrush="#E8DCEF" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#34233E" BlurRadius="30" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="26,22,26,24">
            <TextBlock Text="Đăng nhập Microsoft" FontSize="22" FontWeight="SemiBold" Foreground="#59416F" />
            <TextBlock x:Name="LoginInstructionText" Text="Đang lấy mã đăng nhập…" FontSize="13" Foreground="#95819F" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,14" />
            <Border Background="#F4ECFA" BorderBrush="#DECDEE" BorderThickness="1" CornerRadius="14" Padding="12,16">
              <TextBlock x:Name="LoginCodeText" Text="••••••••" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Foreground="#6C4CA7" HorizontalAlignment="Center" />
            </Border>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0" Foreground="#8864BD" Background="#EFE7F6" BorderThickness="0" />
            <TextBlock x:Name="LoginStatusText" Text="Đang chờ bạn xác nhận trên trình duyệt…" FontSize="11" Foreground="#A18AAE" Margin="0,8,0,16" TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="LoginCancelButton" Content="Hủy" Click="CancelLogin_Click" Background="#F0E8F7" Foreground="#85639F" Padding="10,10" />
              <Button x:Name="LoginCopyButton" Grid.Column="2" Content="Sao chép mã" Click="CopyLoginCode_Click" Background="#EAE0F2" Foreground="#6C4EA3" Padding="10,10" IsEnabled="False" />
              <Button x:Name="LoginOpenButton" Grid.Column="4" Content="Mở trang" Click="OpenLoginPage_Click" Style="{StaticResource PrimaryButton}" Padding="10,10" IsEnabled="False" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ConfirmationOverlay" Grid.RowSpan="2" Panel.ZIndex="200" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="390" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="22" BorderBrush="#E8DCEF" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#34233E" BlurRadius="30" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="26,22,26,24">
            <Grid Margin="0,0,0,17">
              <Border Width="48" Height="48" CornerRadius="15" Background="#FBEAF0" HorizontalAlignment="Left">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#C47891" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Button Content="×" Click="CancelConfirmation_Click" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F4EEF8" Foreground="#A28AB4" FontSize="19" AutomationProperties.Name="Đóng xác nhận" />
            </Grid>
            <TextBlock x:Name="ConfirmationTitle" Text="Xóa cookie này?" FontSize="22" FontWeight="SemiBold" Foreground="#59416F" />
            <TextBlock x:Name="ConfirmationMessage" FontSize="13" Foreground="#95819F" LineHeight="22" Margin="0,11,0,23" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ConfirmationCancelButton" Content="Giữ lại" Click="CancelConfirmation_Click" Background="#F0E8F7" Foreground="#85639F" Padding="15,11" />
              <Button x:Name="ConfirmationDeleteButton" Grid.Column="2" Content="Xóa cookie" Click="AcceptConfirmation_Click" Background="#C77D96" Foreground="White" Padding="15,11" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="UpdateOverlay" Grid.RowSpan="2" Panel.ZIndex="150" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="440" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFCFF" CornerRadius="24" BorderBrush="#E8DCEF" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#34233E" BlurRadius="30" ShadowDepth="7" Opacity="0.22" />
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="27,24">
            <Grid Margin="0,0,0,17">
              <Border Width="48" Height="48" CornerRadius="15" Background="#FFF0DD" HorizontalAlignment="Left">
                <TextBlock Text="↑" FontSize="28" FontWeight="SemiBold" Foreground="#C58848" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="UpdatePreviewLabel" Text="XEM THỬ" Foreground="#AE8ABA" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <TextBlock Text="Một phiên bản mới đã sẵn sàng" FontSize="22" FontWeight="SemiBold" Foreground="#59416F" />
            <TextBlock x:Name="UpdateVersionText" Foreground="#B37C40" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,13" />
            <TextBlock x:Name="UpdateDescription" FontSize="12" Foreground="#95819F" LineHeight="21" />
            <Border Background="#F7F1FA" CornerRadius="12" Padding="15" Margin="0,17,0,15">
              <StackPanel>
                <TextBlock Text="CÓ GÌ MỚI?" FontSize="10" FontWeight="SemiBold" Foreground="#A38AB4" Margin="0,0,0,9" />
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="UpdateNotesText" FontSize="12" Foreground="#846C97" LineHeight="20" />
                </ScrollViewer>
              </StackPanel>
            </Border>
            <ProgressBar x:Name="UpdateDownloadBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#D5A068" Background="#F3E6D8" BorderThickness="0" Visibility="Collapsed" />
            <TextBlock x:Name="UpdateDownloadText" FontSize="11" Foreground="#A18AAE" Margin="0,10,0,16" LineHeight="18" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="UpdateLaterButton" Content="Để sau" Click="UpdateLater_Click" Background="#F1EAF8" Foreground="#9171A7" Padding="18,11" />
              <Button x:Name="InstallUpdateButton" Grid.Column="2" Content="Cập nhật và mở lại" Click="InstallUpdate_Click" Background="#C9945F" Foreground="White" Padding="16,11" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ProxyAddOverlay" Grid.RowSpan="2" Panel.ZIndex="185" Background="#77392C49" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="440" MaxHeight="650" Margin="24" VerticalAlignment="Stretch" Background="#FFFCFF" BorderBrush="#E8DCEF" BorderThickness="1" CornerRadius="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Background="Transparent" BorderBrush="#EAE0F2" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="×" Click="CloseProxyAdd_Click" Width="30" Height="30" Padding="0" AutomationProperties.Name="Đóng thêm proxy" />
              <TextBlock Text="Thêm proxy" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Background="Transparent" Padding="18,12,18,18" x:Name="ProxyInputCard" Grid.Row="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <UniformGrid Columns="2" Margin="0,6,0,0">
                  <Button x:Name="ProxyManualModeButton" Content="Nhập thủ công" Background="#DCCBEF" Click="ProxyManualMode_Click" Margin="0,0,4,0" Padding="6,8" />
                  <Button x:Name="ProxyBulkModeButton" Content="Nhập nhanh" Click="ProxyBulkMode_Click" Padding="6,8" />
                </UniformGrid>
              </StackPanel>
              <ScrollViewer x:Name="ProxyManualForm" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,0">
                  <TextBlock Text="Loại proxy" Margin="0,0,0,6" />
                  <WrapPanel Margin="0,0,0,12">
                    <RadioButton x:Name="ProxySocks5" Content="SOCKS5" GroupName="ProxyProtocol" IsChecked="True" Margin="0,0,12,6" />
                    <RadioButton x:Name="ProxyHttp" Content="HTTP" GroupName="ProxyProtocol" Margin="0,0,12,6" />
                    <RadioButton x:Name="ProxyHttps" Content="HTTPS" GroupName="ProxyProtocol" Margin="0,0,0,6" />
                  </WrapPanel>
                  <TextBlock Text="Địa chỉ IP hoặc tên miền" Margin="0,0,0,5" />
                  <TextBox x:Name="ProxyHostInput" Style="{StaticResource InputField}" AutomationProperties.Name="Địa chỉ proxy" />
                  <TextBlock Text="Ví dụ: 127.0.0.1 hoặc proxy.example.com" FontSize="10" Foreground="#8C7D9E" Margin="0,4,0,12" />
                  <TextBlock Text="Cổng" Margin="0,0,0,5" />
                  <TextBox x:Name="ProxyPortInput" Style="{StaticResource InputField}" MaxLength="5" AutomationProperties.Name="Cổng proxy" />
                  <TextBlock Text="Nhập cổng do nhà cung cấp proxy cung cấp." FontSize="10" Foreground="#8C7D9E" Margin="0,4,0,12" />
                  <TextBlock Text="Tên đăng nhập (nếu có)" Margin="0,0,0,5" />
                  <TextBox x:Name="ProxyUserInput" Style="{StaticResource InputField}" AutomationProperties.Name="Tên đăng nhập proxy" Margin="0,0,0,12" />
                  <TextBlock Text="Mật khẩu (nếu có)" Margin="0,0,0,5" />
                  <Border Background="White" CornerRadius="8" BorderBrush="#E2D6F0" BorderThickness="1" Padding="3">
                    <PasswordBox x:Name="ProxyPasswordInput" BorderThickness="0" Padding="8,7" Background="Transparent" AutomationProperties.Name="Mật khẩu proxy" />
                  </Border>
                  <TextBlock Text="Không yêu cầu xác thực? Để trống tên đăng nhập và mật khẩu." FontSize="10" Foreground="#8C7D9E" Margin="0,6,0,10" />
                  <Button Content="+ Lưu proxy" Click="AddManualProxy_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                </StackPanel>
              </ScrollViewer>
              <DockPanel x:Name="ProxyBulkInput" Visibility="Collapsed" Grid.Row="1">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Mỗi dòng một proxy. Thay địa chỉ, cổng và thông tin đăng nhập bằng dữ liệu của bạn." Foreground="#59416F" FontSize="12" Margin="0,0,0,6" />
                  <Border Background="#F4EEF9" CornerRadius="8" Padding="10,8">
                    <StackPanel>
                      <TextBlock Text="SOCKS5: proxy.example.com:1080" FontSize="11" FontFamily="Consolas" />
                      <TextBlock Text="Có mật khẩu: proxy.example.com:1080:user:pass" FontSize="11" FontFamily="Consolas" />
                      <TextBlock Text="HTTP: http://user:pass@proxy.example.com:8080" FontSize="11" FontFamily="Consolas" />
                      <TextBlock Text="Với HTTP hoặc HTTPS không cần đăng nhập, bỏ phần user:pass@. Dùng https:// nếu proxy yêu cầu HTTPS." Foreground="#59416F" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border Background="#F9F7FC" BorderBrush="#EAE0F2" BorderThickness="1" CornerRadius="8">
                  <TextBox x:Name="ProxyInputText" AutomationProperties.Name="Danh sách proxy, mỗi dòng một proxy" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="10" FontSize="11" FontFamily="Consolas, Segoe UI" />
                </Border>
              </DockPanel>
              <UniformGrid x:Name="ProxyBulkActions" Visibility="Collapsed" Grid.Row="2" Columns="2" Margin="0,10,0,0">
                <Button Content="📋 Dán Clipboard" Click="PasteProxies_Click" Padding="8,8" Margin="0,0,4,0" FontSize="11" />
                <Button Content="+ Lưu Proxy" Click="AddProxies_Click" Style="{StaticResource PrimaryButton}" Padding="8,8" Margin="4,0,0,0" FontSize="11" />
              </UniformGrid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
